# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/investment_advisory
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/investment_advisory

# JWT Authentication
JWT_SECRET_KEY=change-me-to-a-secure-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Server
APP_ENV=development
DEBUG=true
